---
import Base from '../../../layouts/Base.astro';
import StatsView from '../../../components/StatsView.astro';
import { data, prefBySlug, cityByCode, commentary } from '../../../lib/data';
import { faqItems, faqLd, datasetLd } from '../../../lib/seo';
import { SITE } from '../../../config';
import type { District } from '../../../lib/data';
import { man, unitMan } from '../../../lib/format';

export function getStaticPaths() {
  return data.districts.map((d) => ({ params: { pref: d.prefSlug, city: d.cityCode, district: d.name }, props: { district: d } }));
}
const { district: d } = Astro.props as { district: District };
const pref = prefBySlug(d.prefSlug);
const city = cityByCode(d.cityCode);
const place = `${d.cityName}${d.name}`;
const year = d.stats.trend.at(-1)?.year ?? data.latest.year;
const title = `${place}の中古マンション相場【${year}年】取引価格と推移`;
const siblings = data.districts.filter((x) => x.cityCode === d.cityCode && x.name !== d.name);
const url = new URL(`/${pref.slug}/${city.code}/${encodeURIComponent(d.name)}/`, SITE.url).href;
const ld = [faqLd(faqItems(place, d.stats, year)), datasetLd(place, d.stats, url, data.generatedAt)];
---
<Base
  title={title}
  description={`${pref.name}${place}の中古マンションの取引価格は中央値${man(d.stats.price)}（㎡単価${unitMan(d.stats.unitPrice)}）。過去5年の取引${d.stats.count.toLocaleString('ja-JP')}件をもとに、国土交通省の取引データから価格の推移をまとめました。`}
  jsonLd={ld}
  crumbs={[
    { name: 'トップ', href: '/' },
    { name: pref.name, href: `/${pref.slug}/` },
    { name: city.name, href: `/${pref.slug}/${city.code}/` },
    { name: d.name, href: `/${pref.slug}/${city.code}/${d.name}/` },
  ]}
>
  <h1>{title}</h1>
  <StatsView place={place} stats={d.stats} year={year} commentary={commentary(`${d.cityCode}-${d.name}`)} showDistrict={false} />
  {siblings.length > 0 && (
    <>
      <h2>{city.name}のほかの町名</h2>
      <p>{siblings.map((s) => <a href={`/${pref.slug}/${city.code}/${s.name}/`} class="chip">{s.name}</a>)}</p>
      <p><a href={`/${pref.slug}/${city.code}/`}>{city.name}全体の相場を見る →</a></p>
    </>
  )}
</Base>

<style>
  .chip { display: inline-block; margin: 0 6px 8px 0; padding: 7px 14px; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); text-decoration: none; font-size: 14px; line-height: 1.2; }
</style>
