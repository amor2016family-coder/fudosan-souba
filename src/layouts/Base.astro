---
import { SITE, CREDIT } from '../config';
import { data } from '../lib/data';

interface Props {
  title: string;
  description: string;
  crumbs?: { name: string; href: string }[];
  /** 構造化データ（JSON-LD）。検索エンジンとAIに内容を正確に伝えるために使う */
  jsonLd?: Record<string, unknown>[];
}
const { title, description, crumbs = [], jsonLd = [] } = Astro.props;
const fullTitle = crumbs.length > 0 ? `${title}｜${SITE.name}` : title;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const updated = data.generatedAt.slice(0, 10);

const breadcrumbLd = crumbs.length > 0 ? [{
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({
    '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.href, SITE.url).href,
  })),
}] : [];
const siteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  inLanguage: 'ja',
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
};
const graph = [siteLd, ...breadcrumbLd, ...jsonLd];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {data.isSample && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={new URL('/img/ogp.jpg', SITE.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/img/ogp.jpg', SITE.url).href} />
    <meta name="theme-color" content="#0f5f52" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {graph.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
  </head>
  <body>
    {data.isSample && (
      <div class="sample">⚠ 表示中のデータは動作確認用の架空データです（公開不可）</div>
    )}
    <header class="site-header">
      <div class="wrap bar">
        <a href="/" class="logo" aria-label={`${SITE.name} トップへ`}>
          <img class="mark" src="/apple-touch-icon.png" width="30" height="30" alt="" />
          <span class="name">{SITE.name}</span>
        </a>
        <nav class="nav" aria-label="メインメニュー">
          <a href="/tokyo/">東京都の相場</a>
          <a href="/about/">サイトについて</a>
        </nav>
      </div>
    </header>

    <main class="wrap">
      {crumbs.length > 0 && (
        <nav class="crumbs" aria-label="パンくずリスト">
          {crumbs.map((c, i) => (
            i < crumbs.length - 1 ? <><a href={c.href}>{c.name}</a><span aria-hidden="true">›</span></> : <span aria-current="page">{c.name}</span>
          ))}
        </nav>
      )}
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="f-top">
          <div>
            <p class="f-name">{SITE.name}</p>
            <p>国土交通省の不動産取引価格情報をもとに、市区町村・町名ごとの中古マンション相場をまとめています。最終更新：{updated}</p>
          </div>
          <nav class="f-links" aria-label="フッターメニュー">
            <a href="/tokyo/">東京都の相場</a>
            <a href="/about/">運営者情報</a>
            <a href="/privacy/">プライバシーポリシー</a>
          </nav>
        </div>
        <p class="f-note">{CREDIT}</p>
        <p class="f-note">掲載している相場は過去の取引価格を集計したもので、個別の物件の価格を示すものではありません。当サイトは広告（アフィリエイト）による収益で運営しています。</p>
        <p class="f-note">© {new Date().getFullYear()} {SITE.name}</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f5f7f8;
    --surface: #ffffff;
    --surface-2: #eef3f2;
    --text: #10181c;
    --muted: #5c6b74;
    --line: #e2e8e9;
    --line-strong: #cfd9da;
    --brand: #0f5f52;
    --brand-ink: #0b4a40;
    --brand-soft: #e6f1ee;
    --up: #b3400f;
    --down: #14489c;
    --cta: #e0561c;
    --shadow: 0 1px 2px rgba(16, 24, 28, .06), 0 10px 26px -18px rgba(16, 24, 28, .35);
    --radius: 14px;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #10151a;
      --surface: #171d23;
      --surface-2: #1d252c;
      --text: #e9edf0;
      --muted: #9fb0bb;
      --line: #2a343c;
      --line-strong: #3a464f;
      --brand: #4ec4a8;
      --brand-ink: #7ad8c0;
      --brand-soft: #16302a;
      --up: #ff9960;
      --down: #8ab4ff;
      --cta: #f26c2a;
      --shadow: 0 1px 2px rgba(0, 0, 0, .4), 0 10px 26px -18px rgba(0, 0, 0, .9);
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: system-ui, -apple-system, 'Hiragino Sans', 'Noto Sans JP', sans-serif;
    font-size: 16px;
    line-height: 1.85;
    -webkit-text-size-adjust: 100%;
  }
  a { color: var(--brand); text-underline-offset: 3px; }
  .wrap { max-width: 920px; margin: 0 auto; padding: 0 16px; }
  .sample { background: #b91c1c; color: #fff; text-align: center; padding: 6px 16px; font-size: 14px; font-weight: 700; }

  /* ヘッダー */
  .site-header {
    position: sticky; top: 0; z-index: 10;
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }
  .site-header .bar { height: 58px; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .logo { display: inline-flex; align-items: center; gap: 9px; text-decoration: none; color: var(--text); }
  .logo .mark { width: 30px; height: 30px; border-radius: 9px; display: block; }
  .logo .name { font-weight: 800; font-size: 17px; letter-spacing: .02em; }
  .nav { display: flex; gap: 14px; font-size: 13.5px; }
  .nav a { color: var(--muted); text-decoration: none; white-space: nowrap; }

  /* パンくず */
  .crumbs { font-size: 13px; color: var(--muted); margin: 14px 0 6px; display: flex; flex-wrap: wrap; gap: 6px; }
  .crumbs a { color: var(--muted); }

  /* 見出し */
  h1 { font-size: clamp(23px, 5.4vw, 32px); line-height: 1.45; margin: 6px 0 10px; letter-spacing: -.01em; font-weight: 800; }
  h2 {
    font-size: clamp(19px, 4.4vw, 22px); line-height: 1.5; font-weight: 800;
    margin: 44px 0 14px; padding-left: 12px; border-left: 5px solid var(--brand); letter-spacing: -.01em;
  }
  h3 { font-size: 17px; margin: 24px 0 6px; line-height: 1.6; }
  p { margin: 0 0 14px; }
  .lead { color: var(--muted); margin: 0 0 18px; font-size: 16px; }
  .note { font-size: 13px; color: var(--muted); line-height: 1.7; }

  /* カード */
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px; box-shadow: var(--shadow); }

  /* 出典バッジ */
  .badges { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 18px; }
  .badge {
    font-size: 12px; color: var(--muted); background: var(--surface-2);
    border: 1px solid var(--line); border-radius: 999px; padding: 3px 11px; white-space: nowrap;
  }

  /* 表 */
  table { width: 100%; border-collapse: collapse; font-size: 14.5px; font-variant-numeric: tabular-nums; }
  th, td { padding: 10px 6px; line-height: 1.5; border-bottom: 1px solid var(--line); text-align: right; white-space: nowrap; }
  th:first-child, td:first-child { text-align: left; }
  td:first-child a { display: block; margin: -10px -6px; padding: 10px 6px; text-decoration: none; font-weight: 600; }
  tbody tr:nth-child(even) { background: var(--surface-2); }
  tbody tr:last-child td { border-bottom: 0; }
  thead th { color: var(--muted); font-weight: 600; font-size: 12.5px; border-bottom: 1px solid var(--line-strong); }
  .scroll { overflow-x: auto; }
  @media (max-width: 480px) {
    table { font-size: 13.5px; }
    .card.scroll { padding: 10px 12px; }
  }

  .site-footer { margin-top: 72px; padding: 28px 0 44px; border-top: 1px solid var(--line); background: var(--surface); }
  .f-top { display: grid; gap: 14px; margin-bottom: 18px; }
  @media (min-width: 720px) { .f-top { grid-template-columns: 1fr auto; align-items: start; } }
  .f-name { font-weight: 800; margin: 0 0 4px; }
  .f-top p { font-size: 13px; color: var(--muted); margin: 0; line-height: 1.8; }
  .f-links { display: flex; flex-wrap: wrap; gap: 14px; font-size: 13px; }
  .f-note { font-size: 12px; color: var(--muted); margin: 0 0 8px; line-height: 1.75; }
</style>
